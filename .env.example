# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets.

# -----------------------------------------------------------------------------
# Chroma Cloud (REQUIRED for ingest, validate-index, retrieve, golden)
# Get credentials from https://www.trychroma.com/
# -----------------------------------------------------------------------------
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=testDB
CHROMA_HOST=api.trychroma.com

# cloud = Chroma Cloud (default) | ephemeral = in-memory (unit tests only)
VECTOR_STORE_MODE=cloud

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# bge = local BGE model (default, no API key) | hash = tests | openai = OpenAI API
EMBEDDING_PROVIDER=bge

# Only required when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Ingest pipeline options
# -----------------------------------------------------------------------------
FORCE_REINDEX=false
RUN_GOLDEN_QUERIES=true

# Set true once if you changed embedding model/dimensions and need a fresh collection
CHROMA_RESET_COLLECTION=false

# -----------------------------------------------------------------------------
# Generation (Phase 3)
# -----------------------------------------------------------------------------
# extractive = no LLM (default) | openai = GPT via OPENAI_API_KEY
GENERATION_PROVIDER=extractive
